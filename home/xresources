! Font and colors

*.faceName: Fira Code:style=Medium:antialias=true
*.allowBoldFonts: false
*.scaleHeight: 1.1
*.faceSize1: 8
*.faceSize2: 9
*.faceSize3: 10
*.faceSize: 11
*.faceSize4: 12
*.faceSize5: 14
*.faceSize6: 16

! Solarized from https://github.com/solarized/xresources/blob/master/Xresources.light
! Modifications:
!  Foreground is changed to S_base02 to increase contrasts
!  S_base01 is used for bold and italic emulation

#define S_base03        #002b36
#define S_base02        #073642
#define S_base01        #586e75
#define S_base00        #657b83
#define S_base0         #839496
#define S_base1         #93a1a1
#define S_base2         #eee8d5
#define S_base3         #fdf6e3

*background:            S_base3
*foreground:            S_base02
*fadeColor:             S_base3
*cursorColor:           #DEAB0E
*pointerColorBackground:S_base1
*pointerColorForeground:S_base01

#define S_yellow        #b58900
#define S_orange        #cb4b16
#define S_red           #dc322f
#define S_magenta       #d33682
#define S_violet        #6c71c4
#define S_blue          #268bd2
#define S_cyan          #2aa198
#define S_green         #859900
*color0:                S_base02
*color8:                S_base03
*color1:                S_red
*color9:                S_orange
*color2:                S_green
*color10:               S_base01
*color3:                S_yellow
*color11:               S_base00
*color4:                S_blue
*color12:               S_base0
*color5:                S_magenta
*color13:               S_violet
*color6:                S_cyan
*color14:               S_base1
*color7:                S_base2
*color15:               S_base3

! Emulating bold and italic with colors
*.vt100.colorBDMode: true
*.vt100.colorBD: S_base01
*.vt100.colorITMode: true
*.vt100.colorIT: S_base01

! Xterm specific

XTerm.vt100.translations: #override \n\
  Alt <Key>minus: smaller-vt-font() \n\
  Alt <Key>equal: larger-vt-font() \n\
  Alt <Key>C: copy-selection(CLIPBOARD) \n\
  Alt <Key>V: insert-selection(CLIPBOARD) \n\
  Alt Shift <Key>B: spawn-new-terminal("-e", "$EDITOR") \n\
  Alt <Key>B: spawn-new-terminal() \n\
  Alt <Key>Y: print-immediate() \
              spawn-new-terminal("-e", "vim -R `ls -t /tmp/xterm-print-* | head -n1`")

XTerm.vt100.saveLines: 1000

XTerm.printFileImmediate: /tmp/xterm-print-

! vim:ft=xdefaults
